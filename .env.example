# Telegram-Bot bei @BotFather anlegen (/newbot) und Token hier eintragen.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Chat-ID: dem Bot einmal schreiben, dann `webwatcher chat-id` ausführen.
# Mehrere Empfänger mit Komma trennen: TELEGRAM_CHAT_ID=123456789,987654321
# Jede Person muss dem Bot vorher selbst geschrieben haben.
TELEGRAM_CHAT_ID=123456789

# Optional: anderer Pfad zur Konfiguration
# WEBWATCHER_CONFIG=/app/config.yaml

# Web-Oberfläche zum Pflegen der Seiten einschalten.
# Sie hat keine eigene Anmeldung - nur einschalten, wenn ein Reverse Proxy
# davor steht (siehe docker-compose.yml und README).
WEBWATCHER_WEB=false

# BasicAuth für die Weboberfläche in Traefik. Erzeugen mit:
#   htpasswd -nB benutzername
#
# Die Ausgabe MUSS in einfache Anführungszeichen. Ohne sie hält Compose das
# '$05$...' im bcrypt-Hash für Variablen und setzt sie leer ein - der Hash wird
# stillschweigend abgeschnitten und die Anmeldung geht nie. Doppelte
# Anführungszeichen helfen nicht, die einzige Alternative wäre jedes $ zu
# verdoppeln ($$).
# WEBWATCHER_AUTH='frederic:$2y$05$abcdefg...'
